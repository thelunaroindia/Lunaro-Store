# ── Shopify Storefront ────────────────────────────────────────────────
# Your Shopify store's *.myshopify.com domain (not the custom domain).
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Storefront API access token — Shopify Admin → Settings → Apps and sales
# channels → Develop apps → create an app → Storefront API → install →
# copy the "Storefront API access token". This token is scoped for
# public storefront reads/cart writes only. NEVER put an Admin API token
# here or in any NEXT_PUBLIC_ variable.
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Storefront API version, e.g. 2024-10. Keep this current — see
# docs/SHOPIFY_SETUP.md for how to check the latest supported version.
SHOPIFY_API_VERSION=2024-10

# ── Shopify Admin API (server-only) ─────────────────────────────────────
# Used by /api/track-order and /order-confirmation (read_orders) and by
# /api/newsletter (write_customers) via src/lib/shopifyAdmin.ts to look up
# order data and create early-access customer signups. Dev Dashboard apps
# for a store you own don't issue a permanent static token — these are
# OAuth client credentials, exchanged server-side at request time for a
# short-lived Admin API access token. Keep scopes to exactly what's used:
# read_orders + write_customers — never a broader grant than that.
SHOPIFY_ADMIN_CLIENT_ID=
SHOPIFY_ADMIN_CLIENT_SECRET=

# ── Early-access gate (server-only) ─────────────────────────────────────
# Signs the HttpOnly early-access cookie (src/lib/earlyAccess.ts) — a
# random secret with no meaning outside this app, not a credential from
# any external service. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing this value invalidates every previously-granted access cookie.
EARLY_ACCESS_COOKIE_SECRET=

# ── Shopify Customer Accounts (new customer account API) ─────────────
# Leaving these blank is a valid choice, not a half-finished state: the
# Account nav link and /account page are automatically hidden/redirected
# away when SHOPIFY_CUSTOMER_ACCOUNT_URL is unset — guest checkout still
# works fully either way. Set both to enable the "Enter The Orbit" account
# entry page and the header/menu Account link.
SHOPIFY_CUSTOMER_ACCOUNT_CLIENT_ID=
SHOPIFY_CUSTOMER_ACCOUNT_URL=

# ── Site ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://lunaro.in
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/lunarohq

# ── Contact form delivery ──────────────────────────────────────────────
# The contact form posts to /api/contact, which forwards to a transactional
# email provider. Pick one and fill in its secret — see docs/DEPLOYMENT.md.
CONTACT_FORM_PROVIDER=resend
RESEND_API_KEY=
CONTACT_FORM_TO_EMAIL=mayankyadavv95@gmail.com

# ── Analytics (leave blank until real IDs exist — see docs/README) ────
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Shiprocket (fulfilment) ─────────────────────────────────────────────
# Shiprocket is connected to Shopify directly (order sync + fulfilment),
# not to this frontend. No Shiprocket credentials belong in this app.
# See docs/SHIPROCKET_SETUP.md.

# ── Fastr / Shiprocket Checkout ───────────────────────────────────────
# The "seller domain" value Fastr's onboarding/dashboard gives you for the
# hidden #sellerDomain input (src/app/layout.tsx). Public by design — it is
# rendered into a hidden form field on every page, same as Fastr's own
# integration snippet. Get the exact value from Fastr; do not guess it from
# SHOPIFY_STORE_DOMAIN above without confirming with them first.
NEXT_PUBLIC_FASTR_SELLER_DOMAIN=
